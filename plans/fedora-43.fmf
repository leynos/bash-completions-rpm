summary: Install and test the bash-completion RPMs on Fedora 43
context:
  distro: fedora-43
discover:
  how: fmf
provision:
  how: container
  # Digest-pinned fedora:43 (as of 2026-07-26) for reproducible guests
  image: registry.fedoraproject.org/fedora@sha256:af06c24b2e90bef115bba80e428ac21466db8869ad544f3424b969513b67eeae
prepare:
  - name: install-built-rpms
    how: install
    directory: dist/fedora-43
execute:
  how: tmt
